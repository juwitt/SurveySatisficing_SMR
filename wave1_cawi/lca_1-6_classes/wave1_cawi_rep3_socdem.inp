TITLE:      Wave 1 CAWI LCA for 3 LC - Replicated winner model with sociodemographic predictors (R3STEP)

DATA:       FILE IS ../Data_LCA.dat;

VARIABLE:   NAMES ARE
            pid hid EXT1 MID1 FTM1 INR1 NDWO1 NDSS1
            NDSO1 SPEE1 BO1 TGANC GENF MIGY AGET1 AGET3
            EDTERT EDNA EMPP EMPNO EMPRET EMPNA KIDY KIDNA
            INCT1 INCT3 INCNA;

            IDVARIABLE IS pid;

            USEVARIABLES ARE
            EXT1 MID1 FTM1 INR1 NDWO1 NDSS1 NDSO1 BO1 SPEE1;

            CATEGORICAL ARE
            EXT1 MID1 FTM1 INR1 NDWO1 NDSS1 NDSO1 BO1 SPEE1;

            MISSING IS ALL(-99);

            CLUSTER IS hid;

            CLASSES ARE c(3);

            AUXILIARY ARE
                    TGANC (R3STEP)
                         !Ref: Anker
                    AGET1 (R3STEP) AGET3 (R3STEP)
                         !Ref: medium (2nd tertile)
                    GENF (R3STEP)
                         !Ref: Not female
                    MIGY (R3STEP)
                         !Ref: No migration
                    EDTERT (R3STEP) EDNA (R3STEP)
                         !Ref: Non-tertiary (ISCED <5)
                    EMPP (R3STEP) EMPNO (R3STEP) EMPRET (R3STEP) EMPNA (R3STEP)
                         !Ref: Full-time
                    KIDY (R3STEP) KIDNA (R3STEP)
                         !Ref: No child in hh
                    INCT1 (R3STEP) INCT3 (R3STEP) INCNA(R3STEP);
                         !Ref: Medium


ANALYSIS:   TYPE IS MIXTURE COMPLEX;
            STARTS ARE 0;
            OPTSEED IS 930872;

OUTPUT:     SVALUES CINTERVAL TECH11;


SAVEDATA: FILE IS wave1_cawi_final.dat; FORMAT IS FREE; SAVE = CPROBABILITIES;
