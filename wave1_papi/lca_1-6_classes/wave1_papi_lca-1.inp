TITLE:      Wave 1 PAPI LCA for 1 LC

DATA:       FILE IS ../Data_LCA.dat;

VARIABLE:   NAMES ARE
            pid hid EXT1 MID1 FTM1 INR1 NDWO1 NDSS1
            NDSO1 TGANC GENF MIGY AGET1 AGET3 EDTERT EDNA
            EMPP EMPNO EMPRET EMPNA KIDY KIDNA INCT1 INCT3
            INCNA;

            USEVARIABLES ARE
            EXT1 MID1 FTM1 INR1 NDWO1 NDSS1 NDSO1;

            CATEGORICAL ARE
            EXT1 MID1 FTM1 INR1 NDWO1 NDSS1 NDSO1;

            MISSING IS ALL(-99);

            CLUSTER IS hid;

            CLASSES ARE c(1);

ANALYSIS:   TYPE IS MIXTURE COMPLEX;
            ESTIMATOR IS MLR;
            STARTS ARE 1000 500;
            STITERATIONS ARE 100;
            PROCESSORS ARE 8 8;

OUTPUT:     SVALUES CINTERVAL;
