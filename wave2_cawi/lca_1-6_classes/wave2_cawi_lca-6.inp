TITLE:      Wave 2 CAWI LCA for 6 LC

DATA:       FILE IS ../Data_LCA.dat;

VARIABLE:   NAMES ARE
            pid hid EXT2 MID2 FTM2 INR2 NDWO2 NDSS2
            NDSO2 SPEE2 BO2 TGANC GENF MIGY AGET1 AGET3
            EDTERT EDNA EMPP EMPNO EMPRET EMPNA KIDY KIDNA
            INCT1 INCT3 INCNA;

            USEVARIABLES ARE
            EXT2 MID2 FTM2 INR2 NDWO2 NDSS2 NDSO2 BO2 SPEE2;

            CATEGORICAL ARE
            EXT2 MID2 FTM2 INR2 NDWO2 NDSS2 NDSO2 BO2 SPEE2;

            MISSING IS ALL(-99);

            CLUSTER IS hid;

            CLASSES ARE c(6);

ANALYSIS:   TYPE IS MIXTURE COMPLEX;
            ESTIMATOR IS MLR;
            STARTS ARE 1000 500;
            STITERATIONS ARE 100;
            PROCESSORS ARE 8 8;

OUTPUT:     SVALUES CINTERVAL TECH11;
