TITLE:      Wave 1 PAPI LCA Sensitivity Analysis for 3 LC - Replication with doubled starts (winner model)

DATA:       FILE IS ../Data_LCA.dat;

VARIABLE:   NAMES ARE
            pid hid EXT1 MID1 FTM1 INR1 NDWO1 NDSS1
            NDSO1 TGANC GENF MIGY AGET1 AGET3 EDTERT EDNA
            EMPP EMPNO EMPRET EMPNA KIDY KIDNA INCT1 INCT3
            INCNA PCONS;

            USEVARIABLES ARE
            EXT1 MID1 FTM1 INR1 NDWO1 NDSS1 NDSO1;

            CATEGORICAL ARE
            EXT1 MID1 FTM1 INR1 NDWO1 NDSS1 NDSO1;

            MISSING IS ALL(-99);

            CLUSTER IS hid;

            CLASSES ARE c(3);

ANALYSIS:   TYPE IS MIXTURE COMPLEX;
            ESTIMATOR IS MLR;
            STARTS ARE 2000 1000;
            STITERATIONS ARE 200;
            PROCESSORS ARE 8 8;

OUTPUT:     SVALUES CINTERVAL TECH11;
